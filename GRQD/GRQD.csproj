<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="../LocalPaths.targets" Condition="Exists('../LocalPaths.targets')" />

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>GRQD</AssemblyName>
		<RootNamespace>GRQD</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>false</IsPackable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<NoWarn>$(NoWarn);MSB3277</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\LegionCore\LegionCore.csproj" />
		<Reference Include="MelonLoader"><HintPath>$(MelonLoaderNet6Path)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="0Harmony"><HintPath>$(MelonLoaderNet6Path)\0Harmony.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="Il2CppInterop.Runtime"><HintPath>$(MelonLoaderNet6Path)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="Il2Cppmscorlib"><HintPath>$(ManagedDllPath)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine"><HintPath>$(ManagedDllPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDllPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDllPath)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.UI"><HintPath>$(ManagedDllPath)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDllPath)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
		<!-- Needed for Physics.Raycast in the test-van ground-snap spawn logic (Plugin.cs) -
		     LegionCore.csproj already had this, GRQD.csproj never needed it before now. -->
		<Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDllPath)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="Assembly-CSharp"><HintPath>$(ManagedDllPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="Il2CppFishNet.Runtime"><HintPath>$(ManagedDllPath)\Il2CppFishNet.Runtime.dll</HintPath><Private>false</Private></Reference>
	</ItemGroup>

	<!-- Real logo art, baked into the DLL so there's no separate file to deploy/lose track of.
	     LogicalName pins the exact manifest resource name (UiFactory.LoadEmbeddedSprite reads
	     it) instead of relying on RootNamespace+path mangling of the hyphenated filename. -->
	<ItemGroup>
		<EmbeddedResource Include="Assets\grqd-icon-64.png">
			<LogicalName>GRQD.icon.png</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- Copy the built DLL and its LegionCore dependency straight to the dev profile's Mods folder after each build. -->
	<Target Name="CopyToProfile" AfterTargets="Build" Condition="'$(ModOutputPath)' != ''">
		<MakeDir Directories="$(ModOutputPath)" />
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ModOutputPath)" />
		<Copy SourceFiles="$(OutputPath)LegionCore.dll" DestinationFolder="$(ModOutputPath)" Condition="Exists('$(OutputPath)LegionCore.dll')" />
	</Target>
</Project>
