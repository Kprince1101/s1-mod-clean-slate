<!--
  Copy this file to LocalPaths.targets at the repo root and fill in your actual paths.
  LocalPaths.targets is gitignored -- it's per-machine, never committed. Shared by every
  mod project in this repo (CleanSlate, DeliveryDriver, ...) since they all build against
  the same game install.
-->
<Project>
	<PropertyGroup>
		<!-- Typically: <profile>\MelonLoader\net6 -->
		<MelonLoaderNet6Path>C:\Users\you\AppData\Roaming\r2modmanPlus-local\ScheduleI\profiles\YourProfile\MelonLoader\net6</MelonLoaderNet6Path>
		<!-- Typically: <profile>\MelonLoader\Il2CppAssemblies -->
		<ManagedDllPath>C:\Users\you\AppData\Roaming\r2modmanPlus-local\ScheduleI\profiles\YourProfile\MelonLoader\Il2CppAssemblies</ManagedDllPath>
		<!-- Where the built DLL should be copied after each build, so it's picked up on next launch.
		     r2modman only scans the flat top-level Mods folder, not hand-made subfolders - so this
		     must be <profile>\Mods itself, not a subfolder under it. -->
		<ModOutputPath>C:\Users\you\AppData\Roaming\r2modmanPlus-local\ScheduleI\profiles\YourProfile\Mods</ModOutputPath>
	</PropertyGroup>
</Project>
